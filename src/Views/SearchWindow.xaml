<Window
    x:Class="L5ArgentinaLauncher.Views.SearchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:loc="clr-namespace:L5ArgentinaLauncher.Resources"
    xmlns:v="clr-namespace:L5ArgentinaLauncher.Views"
    Title="{loc:Loc Search_Title}"
    Width="1323" Height="798" MinWidth="1060" MinHeight="640"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    Background="{StaticResource ParchmentBackground}"
    Icon="pack://application:,,,/Assets/icon.png"
    KeyDown="Window_KeyDown"
    KeyUp="Window_KeyUp"
    Deactivated="Window_Deactivated"
    StateChanged="Window_StateChanged">

    <!-- Chrome custom (como MainWindow) pero redimensionable y con maximizar -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="35" CornerRadius="0" GlassFrameThickness="0"
                            ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Estilos compartidos con la ventana de Mazos: Views/CardUiStyles.xaml
             (CheckBox/ComboBox/Expander/chips/cabeceras). Acá quedan solo los recursos
             propios del Buscador. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CardUiStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <v:HexBrushConverter x:Key="HexBrush" />

        <!-- Fondo claro de las pastillas de estado: contraste garantizado para el texto
             (los colores de rules.json son oscuros: negro UNIQUE, rojo BANNED). -->
        <SolidColorBrush x:Key="LabelPillBg" Color="#F2F1E8D5" />

        <!-- Botón compacto de la barra de acciones de las celdas -->
        <Style x:Key="CellActionBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="5" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Red}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Celda de la grilla de miniaturas: nombre de fondo (placeholder) + imagen encima
             + barra de acciones al pie (hover/selección), como la HalfCardCell de la app -->
        <DataTemplate x:Key="GridCellTemplate">
            <Border x:Name="cellRoot" Width="226" Height="322" Margin="5" CornerRadius="11"
                    BorderThickness="2" Cursor="Hand" MouseLeftButtonUp="GridCell_Click"
                    MouseLeftButtonDown="GridCell_MouseDown">
                <!-- El marco (borde + fondo) es el *placeholder*: solo se ve cuando no hay imagen.
                     Con arte, la celda es el arte y nada más; el borde vuelve al pasar el mouse o
                     al seleccionar, que es donde sí comunica algo. -->
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Background.ImageSource, ElementName=cellArt}"
                                         Value="{x:Null}">
                                <Setter Property="BorderBrush" Value="#33C9A961" />
                                <Setter Property="Background" Value="#4D140A05" />
                            </DataTrigger>
                            <!-- Segunda ayuda visual: con Ctrl apretado se prenden TODAS las celdas,
                                 no solo la de abajo del mouse. Comunica que hay un modo activo. -->
                            <DataTrigger Binding="{Binding IsAddModifierDown, RelativeSource={RelativeSource AncestorType=Window}}"
                                         Value="True">
                                <Setter Property="BorderBrush" Value="#66C9A961" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource GoldDim}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Gold}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <TextBlock Text="{Binding Card.Name}" TextWrapping="Wrap" TextAlignment="Center"
                               VerticalAlignment="Center" Margin="10" FontFamily="{StaticResource BodyFont}"
                               FontSize="12" Foreground="{StaticResource TextDim}" />
                    <!-- ImageBrush sobre un Border en vez de un Image: así el arte respeta el
                         CornerRadius y se comen las puntitas blancas del escaneo (las cartas de
                         L5R son escaneos rectangulares de cartas con esquinas redondeadas).
                         UniformToFill llena la celda entera: sin letterbox no hay marco que asome. -->
                    <Border x:Name="cellArt" CornerRadius="9">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Thumb, IsAsync=True}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <!-- Pastilla de estado compacta (BANNED/UNIQUE…): fondo claro fijo para que
                         se lea sobre el arte; borde/texto del color de rules.json -->
                    <Border CornerRadius="8" Padding="7,2" Margin="0,7,7,0" BorderThickness="1"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            BorderBrush="{Binding Card.LabelColor, Converter={StaticResource HexBrush}}"
                            Background="{StaticResource LabelPillBg}"
                            ToolTip="{Binding Card.Note}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Card.LabelText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Card.LabelText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Card.LabelText}" FontFamily="{StaticResource BodyFont}"
                                   FontSize="9" FontWeight="Bold"
                                   Foreground="{Binding Card.LabelColor, Converter={StaticResource HexBrush}}" />
                    </Border>

                    <!-- Cantidad en el mazo activo (esquina sup. izq., visible si > 0) -->
                    <Border CornerRadius="8" Padding="7,2" Margin="7,7,0,0" BorderThickness="1"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="#E5140A05" BorderBrush="{StaticResource GoldDim}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DeckQtyText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding DeckQtyText}" FontFamily="{StaticResource BodyFont}"
                                   FontSize="11" FontWeight="Bold" Foreground="{StaticResource Gold}" />
                    </Border>

                    <!-- Barra de acciones (hover / seleccionada): mazo activo, favorita,
                         oculta, lista activa -->
                    <Border VerticalAlignment="Bottom" Background="#E0140A05" CornerRadius="0,0,5,5"
                            Padding="3,3">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=cellRoot}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource CellActionBtn}" Content="−"
                                    ToolTip="{loc:Loc Cell_MinusTip}" Click="CellMinus_Click" />
                            <Button Style="{StaticResource CellActionBtn}" Content="+"
                                    ToolTip="{loc:Loc Cell_PlusTip}" Click="CellPlus_Click" />
                            <Rectangle Width="1" Margin="4,3" Fill="{StaticResource OutlineSoft}" />
                            <Button Style="{StaticResource CellActionBtn}" Click="CellFav_Click"
                                    ToolTip="{loc:Loc Cell_FavTip}">
                                <TextBlock Text="★">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFav}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <Button Style="{StaticResource CellActionBtn}" Click="CellHide_Click"
                                    ToolTip="{loc:Loc Cell_HideTip}">
                                <TextBlock Text="⊘">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource ErrorText}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <Button Style="{StaticResource CellActionBtn}" Click="CellList_Click"
                                    ToolTip="{loc:Loc Cell_ListTip}">
                                <TextBlock Text="≡">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding InList}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Overlay de "Ctrl = agregar": va último para quedar encima de todo, así
                         tapa también la barra de acciones y el Ctrl+click cae siempre acá.
                         Es a la vez la ayuda visual y el blanco del click. -->
                    <!-- Ojo: la visibilidad va SOLO por el Style, como la botonera de arriba.
                         Un Visibility="Collapsed" local le gana a cualquier trigger (precedencia
                         de WPF: valor local > Style trigger) y el overlay no aparecería nunca. -->
                    <Border x:Name="AddOverlay" CornerRadius="9" Background="#CC140A05"
                            BorderThickness="2" BorderBrush="{StaticResource Gold}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsMouseOver, ElementName=cellRoot}" Value="True" />
                                            <Condition Binding="{Binding IsAddModifierDown, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="+" FontFamily="{StaticResource BodyFont}" FontSize="46"
                                       Foreground="{StaticResource Gold}" HorizontalAlignment="Center" />
                            <TextBlock Text="{loc:Loc Cell_CtrlAddOverlay}" FontFamily="{StaticResource BodyFont}"
                                       FontSize="14" Foreground="{StaticResource Text}" Margin="0,4,0,0"
                                       TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Fila de resultados -->
        <Style x:Key="ResultRow" TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="bd" Background="Transparent" Padding="2,3">
                            <GridViewRowPresenter Content="{TemplateBinding Content}"
                                Columns="{Binding Path=View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22C9A961" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#CC7D1F1C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Banned}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource ErrorText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootLayout">
        <!-- Capas de fondo -->
        <Rectangle Fill="{StaticResource PaperOverlayBrush}" IsHitTestVisible="False" />
        <Rectangle Fill="{StaticResource BackgroundScrim}" IsHitTestVisible="False" />
        <Border BorderBrush="#552A1710" BorderThickness="1" IsHitTestVisible="False" />

        <DockPanel>
            <!-- ===== Title bar custom ===== -->
            <Grid DockPanel.Dock="Top" Height="36" Background="{StaticResource Surface}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="pack://application:,,,/Assets/icon.png" Width="20" Height="20" Margin="0,0,9,0" />
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontFamily="{StaticResource BrushFont}" FontSize="16"
                               Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Content="—"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MinButton_Click" />
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="□" FontSize="18"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MaxButton_Click" />
                    <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButton}" Content="✕"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <Grid Margin="16,12,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ===== Barra superior (2 filas): búsqueda | toggles rápidos + vista + orden ===== -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Sin título acá: ya lo muestra la barra de título propia (Window.Title).
                         La caja crece hasta 480 y el contador queda pegado a su derecha. -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="480" MinWidth="260" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBox x:Name="NameBox" Style="{StaticResource InvertedTextBox}"
                                     ToolTip="{loc:Loc Search_BarOperatorsTip}"
                                     TextChanged="FilterText_Changed" KeyDown="NameBox_KeyDown" />
                            <TextBlock Text="{loc:Loc Search_NameHint}" Foreground="{StaticResource InputPlace}"
                                       Margin="16,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="14">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=NameBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <TextBlock x:Name="ResultCount" Grid.Column="1" Style="{StaticResource Body}"
                                   Foreground="{StaticResource Gold}" VerticalAlignment="Center" Margin="14,0,18,0" />

                        <!-- Vista + orden (a la derecha de la fila 1 para que la fila 2 no desborde) -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton x:Name="ViewListBtn" Style="{StaticResource SegmentLeft}"
                                          Content="{loc:Loc Search_ViewList}" Click="ViewToggle_Click" />
                            <ToggleButton x:Name="ViewGridBtn" Style="{StaticResource SegmentRight}"
                                          IsChecked="True" Content="{loc:Loc Search_ViewGrid}"
                                          Click="ViewToggle_Click" />
                            <!-- Sub-opción de la grilla (se deshabilita en vista Lista): chip chico
                                 para que la etiqueta larga no compita con el segmentado. -->
                            <ToggleButton x:Name="ExpandPrintsBtn" Style="{StaticResource FilterChipSmall}"
                                          Margin="8,0,0,0" VerticalAlignment="Center"
                                          Content="{loc:Loc Search_ExpandPrints}"
                                          ToolTip="{loc:Loc Search_ExpandPrintsTip}"
                                          Checked="ExpandPrints_Changed" Unchecked="ExpandPrints_Changed" />
                            <ComboBox x:Name="SortCombo" Style="{StaticResource ChipCombo}" Width="120" Margin="12,0,0,0"
                                      SelectionChanged="Filter_Changed" />
                            <ToggleButton x:Name="SortDirBtn" Style="{StaticResource IconToggle}"
                                          Margin="8,0,0,0" IsChecked="False"
                                          Checked="Filter_Changed" Unchecked="Filter_Changed"
                                          ToolTip="{loc:Loc Search_SortDirTip}" Content="↑" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Limpiar va primero: es el reset de la fila de filtros que sigue.
                             (El colapso de paneles vive ahora en los rieles laterales.) -->
                        <Button x:Name="ClearFiltersBtn" Grid.Column="0" Content="{loc:Loc Search_ClearFilters}"
                                Style="{StaticResource GhostButton}" FontSize="14" Height="32"
                                Margin="0,0,14,0" Click="ClearFilters_Click" />

                        <!-- Toggles rápidos (antes enterrados en el panel de filtros) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton x:Name="QuickFavBtn" Style="{StaticResource FilterChipSmall}"
                                          Margin="0,0,6,0" Content="{loc:Loc Search_OnlyFavorites}"
                                          Checked="Filter_Changed" Unchecked="Filter_Changed" />
                            <ToggleButton x:Name="QuickHiddenBtn" Style="{StaticResource FilterChipSmall}"
                                          Margin="0,0,12,0" Content="{loc:Loc Search_ShowHidden}"
                                          Checked="Filter_Changed" Unchecked="Filter_Changed" />
                        </StackPanel>

                        <!-- Conjunto activo: se elige acá. El desplegable ofrece las listas,
                             favoritas y ocultas, y una entrada "Usar mazo…" que recién ahí baja
                             a la lista de mazos. "Solo conjunto" filtra los resultados a sus
                             cartas (armar el mazo de ninjas desde la lista de ninjas, o filtrar
                             por lo que ya está en un mazo). El ≡ de las cartas carga la lista. -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton x:Name="QuickListBtn" Style="{StaticResource FilterChipSmall}"
                                          Margin="0,0,6,0" Content="{loc:Loc Search_OnlyListShort}"
                                          ToolTip="{loc:Loc Search_OnlyListTip}"
                                          Checked="Filter_Changed" Unchecked="Filter_Changed" />
                            <ComboBox x:Name="SetFilterCombo" Style="{StaticResource ChipCombo}" Width="172"
                                      ToolTip="{loc:Loc Search_ListFilterTip}"
                                      SelectionChanged="SetFilterCombo_Changed" />
                            <!-- Crear/borrar lista: salieron del panel de filtros a íconos discretos
                                 pegados al combo, que es donde se elige el conjunto. -->
                            <Button x:Name="ListNewBtn" Style="{StaticResource IconButton}" Margin="6,0,0,0"
                                    Content="+" ToolTip="{loc:Loc Search_ListCreateTip}"
                                    Click="ListCreate_Click" />
                            <Button x:Name="SetToListBtn" Style="{StaticResource IconButton}" Margin="3,0,0,0"
                                    Content="⎘" FontSize="12" ToolTip="{loc:Loc Search_SetToListTip}"
                                    Click="SetToList_Click" />
                            <Button x:Name="ListDeleteBtn" Style="{StaticResource IconButton}" Margin="3,0,0,0"
                                    Content="🗑" FontSize="12" ToolTip="{loc:Loc Search_ListDeleteTip}"
                                    Click="ListDelete_Click" />
                        </StackPanel>

                        <!-- Mazo activo: destino de todos los +/−. Es un LABEL, no un selector: el
                             mazo activo es el que está seleccionado en la ventana de Mazos, y esa
                             es la única fuente de verdad (ADR-042). Clickearlo abre esa ventana. -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Search_ActiveDeckLabel}" Style="{StaticResource BodySmall}"
                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock x:Name="ActiveDeckName" Style="{StaticResource Body}" FontSize="13"
                                       Foreground="{StaticResource Gold}" VerticalAlignment="Center"
                                       Cursor="Hand" TextTrimming="CharacterEllipsis" MaxWidth="220"
                                       ToolTip="{loc:Loc Search_ActiveDeckTip}"
                                       MouseLeftButtonUp="DecksBtn_Click" />
                            <TextBlock x:Name="ActiveDeckCounts" Style="{StaticResource BodySmall}" FontSize="11"
                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                       ToolTip="{loc:Loc Search_ActiveDeckCountsTip}" />
                            <Button x:Name="DecksBtn" Content="{loc:Loc Search_DecksBtn}"
                                    Style="{StaticResource GhostButton}" Height="32" FontSize="14" Padding="12,0"
                                    Margin="10,0,0,0"
                                    ToolTip="{loc:Loc Search_DecksBtnTip}" Click="DecksBtn_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ===== Cuerpo: filtros | resultados | mazo + detalle (laterales colapsables) ===== -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <!-- Anchos pensados para ~1200 DIP útiles (monitor 1080p a 125%):
                             con ambos paneles entran 2 columnas de cartas; cada colapso suma una
                             (libera 270 / 405 DIP contra una celda de 226).
                             Las columnas de 16 son los rieles de colapso y NO colapsan nunca:
                             son la única forma de reabrir el panel. -->
                        <ColumnDefinition x:Name="FiltersCol" Width="270" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" MinWidth="320" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition x:Name="DetailCol" Width="405" />
                    </Grid.ColumnDefinitions>

                    <!-- Rieles: el chevron apunta adónde se va el borde al hacer click.
                         Content = glifo con el panel abierto; Tag = glifo con el panel colapsado. -->
                    <ToggleButton x:Name="FiltersPaneBtn" Grid.Column="1" Style="{StaticResource PaneRail}"
                                  Content="❮" Tag="❯" ToolTip="{loc:Loc Search_PaneFiltersTip}"
                                  Click="PaneToggle_Click" />
                    <ToggleButton x:Name="DetailPaneBtn" Grid.Column="3" Style="{StaticResource PaneRail}"
                                  Content="❯" Tag="❮" ToolTip="{loc:Loc Search_PaneDetailTip}"
                                  Click="PaneToggle_Click" />

                    <!-- Panel de filtros (colapsable; aplican en vivo) -->
                    <Border x:Name="FiltersPanel" Grid.Column="0" Background="{StaticResource SurfaceGlassSoft}" CornerRadius="9"
                            BorderBrush="{StaticResource OutlineSoft}" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,6,12,12">
                            <StackPanel>
                                <!-- 1. Keywords -->
                                <Expander Header="{loc:Loc Search_Section_Keywords}" Style="{StaticResource FilterExpander}"
                                          IsExpanded="True">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="KwCombo" IsEditable="True" Height="28"
                                                      IsTextSearchEnabled="False" KeyDown="KwCombo_KeyDown" />
                                            <Button Grid.Column="1" Content="+" Style="{StaticResource GhostButton}"
                                                    Height="28" Padding="10,0" FontSize="16" Margin="6,0,0,0"
                                                    Click="KwAdd_Click" ToolTip="{loc:Loc Search_KwAddTip}" />
                                        </Grid>
                                        <WrapPanel x:Name="KwChips" Margin="0,8,0,0" />

                                        <Expander Header="{loc:Loc Search_KwAdvanced}" Style="{StaticResource SubExpander}">
                                            <StackPanel>
                                                <TextBlock Text="{loc:Loc Search_KwExclude}" Style="{StaticResource BodySmall}"
                                                           FontSize="12" Margin="0,2,0,4" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox x:Name="NegKwCombo" IsEditable="True" Height="28"
                                                              IsTextSearchEnabled="False" KeyDown="NegKwCombo_KeyDown" />
                                                    <Button Grid.Column="1" Content="−" Style="{StaticResource GhostButton}"
                                                            Height="28" Padding="10,0" FontSize="16" Margin="6,0,0,0"
                                                            Click="NegKwAdd_Click" ToolTip="{loc:Loc Search_KwExcludeTip}" />
                                                </Grid>
                                                <WrapPanel x:Name="NegKwChips" Margin="0,8,0,0" />

                                                <CheckBox x:Name="KwMatchAllBox" Content="{loc:Loc Search_KwMatchAll}"
                                                          Style="{StaticResource FilterCheck}" IsChecked="True"
                                                          Checked="Filter_Changed" Unchecked="Filter_Changed" />
                                                <CheckBox x:Name="KwActionBox" Content="{loc:Loc Search_KwAction}"
                                                          Style="{StaticResource FilterCheck}" IsChecked="True"
                                                          Checked="Filter_Changed" Unchecked="Filter_Changed" />
                                                <CheckBox x:Name="KwSubtitleBox" Content="{loc:Loc Search_KwSubtitle}"
                                                          Style="{StaticResource FilterCheck}" IsChecked="True"
                                                          Checked="Filter_Changed" Unchecked="Filter_Changed" />
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Expander>

                                <!-- 2. Texto de la carta -->
                                <Expander Header="{loc:Loc Search_Section_CardText}" Style="{StaticResource FilterExpander}"
                                          IsExpanded="True">
                                    <StackPanel>
                                        <TextBox x:Name="TextSearchBox" Style="{StaticResource InvertedTextBox}" Height="32"
                                                 FontSize="13" TextChanged="FilterText_Changed"
                                                 ToolTip="{loc:Loc Search_CardTextTip}" />
                                        <TextBlock Text="{loc:Loc Search_CardTextHint}" Style="{StaticResource BodySmall}"
                                                   FontSize="11" Margin="2,4,0,0" />
                                    </StackPanel>
                                </Expander>

                                <!-- 3. Tipo -->
                                <Expander Header="{loc:Loc Search_Section_Type}" Style="{StaticResource FilterExpander}"
                                          IsExpanded="True">
                                    <WrapPanel x:Name="TypeChips" />
                                </Expander>

                                <!-- 4. Clan -->
                                <Expander Header="{loc:Loc Search_Section_Clan}" Style="{StaticResource FilterExpander}"
                                          IsExpanded="True">
                                    <WrapPanel x:Name="ClanChips" />
                                </Expander>

                                <!-- 5. Designador -->
                                <Expander Header="{loc:Loc Search_Section_Designators}" Style="{StaticResource FilterExpander}">
                                    <WrapPanel x:Name="DesignatorChips" />
                                </Expander>

                                <!-- 6. Stats -->
                                <Expander Header="{loc:Loc Search_Section_Stats}" Style="{StaticResource FilterExpander}">
                                    <StackPanel x:Name="StatsPanel" Margin="0,4,0,0" />
                                </Expander>

                                <!-- 7. Edición -->
                                <Expander Header="{loc:Loc Search_Section_Sets}" Style="{StaticResource FilterExpander}">
                                    <StackPanel x:Name="SetChecks" Margin="0,4,0,0" />
                                </Expander>

                                <!-- 8. Rareza -->
                                <Expander Header="{loc:Loc Search_Section_Rarity}" Style="{StaticResource FilterExpander}">
                                    <WrapPanel x:Name="RarityChips" />
                                </Expander>

                                <!-- 9. Otros (los toggles frecuentes viven en la barra superior) -->
                                <Expander Header="{loc:Loc Search_Section_Other}" Style="{StaticResource FilterExpander}">
                                    <StackPanel>
                                        <CheckBox x:Name="IncludeBannedBox" Content="{loc:Loc Search_IncludeBanned}"
                                                  Style="{StaticResource FilterCheck}"
                                                  Checked="Filter_Changed" Unchecked="Filter_Changed" />
                                        <CheckBox x:Name="OnlyHiddenBox" Content="{loc:Loc Search_OnlyHidden}"
                                                  Style="{StaticResource FilterCheck}"
                                                  Checked="Filter_Changed" Unchecked="Filter_Changed" />
                                    </StackPanel>
                                </Expander>

                                <!-- Las listas se crean, eligen y borran en la barra superior
                                     (combo + iconos), no acá: son navegación, no un filtro más. -->

                                <!-- 10. Presets de filtros -->
                                <Expander Header="{loc:Loc Search_Section_Presets}" Style="{StaticResource FilterExpander}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="PresetCombo" Height="28" />
                                            <Button Grid.Column="1" Content="{loc:Loc Search_PresetLoad}"
                                                    Style="{StaticResource GhostButton}" Height="28" FontSize="13"
                                                    Padding="10,0" Margin="6,0,0,0" Click="PresetLoad_Click" />
                                            <Button Grid.Column="2" Content="✕" Style="{StaticResource GhostButton}"
                                                    Height="28" FontSize="13" Padding="8,0" Margin="6,0,0,0"
                                                    ToolTip="{loc:Loc Search_PresetDeleteTip}" Click="PresetDelete_Click" />
                                        </Grid>
                                        <TextBlock Text="{loc:Loc Search_PresetSaveLabel}" Style="{StaticResource BodySmall}"
                                                   FontSize="12" Margin="0,10,0,4" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="PresetNameBox" Style="{StaticResource InvertedTextBox}"
                                                     Height="28" FontSize="13" KeyDown="PresetNameBox_KeyDown" />
                                            <Button Grid.Column="1" Content="{loc:Loc Search_PresetSave}"
                                                    Style="{StaticResource GhostButton}" Height="28" FontSize="13"
                                                    Padding="10,0" Margin="6,0,0,0" Click="PresetSave_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Resultados (tabla; cabeceras clickeables para ordenar) -->
                    <ListView x:Name="ResultsList" Grid.Column="2" Visibility="Collapsed"
                              Background="#66140A05" BorderBrush="{StaticResource OutlineSoft}" BorderThickness="1"
                              ItemContainerStyle="{StaticResource ResultRow}"
                              GridViewColumnHeader.Click="ResultsHeader_Click"
                              MouseDoubleClick="ResultsList_MouseDoubleClick"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              SelectionMode="Single" SelectionChanged="ResultsList_SelectionChanged">
                        <ListView.View>
                            <GridView AllowsColumnReorder="True">
                                <GridViewColumn Header="{loc:Loc Search_Col_Name}" Width="250" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="{loc:Loc Search_Col_Type}" Width="92" DisplayMemberBinding="{Binding Type}" />
                                <GridViewColumn Header="{loc:Loc Search_Col_Clan}" Width="86" DisplayMemberBinding="{Binding Clan}" />
                                <GridViewColumn Header="{loc:Loc Search_Col_Rarity}" Width="52" DisplayMemberBinding="{Binding Rarity}" />
                                <GridViewColumn Header="{loc:Loc Search_Col_Cost}" Width="52" DisplayMemberBinding="{Binding DisplayCost}" />
                                <GridViewColumn Header="{loc:Loc Search_Col_Force}" Width="42" DisplayMemberBinding="{Binding DisplayForce}" />
                                <GridViewColumn Header="{loc:Loc Search_Col_Chi}" Width="42" DisplayMemberBinding="{Binding DisplayChi}" />
                                <GridViewColumn Header="{loc:Loc Search_Col_Honor}" Width="46" DisplayMemberBinding="{Binding DisplayHonor}" />
                                <GridViewColumn Header="{loc:Loc Search_Col_PHonor}" Width="46" DisplayMemberBinding="{Binding DisplayPersonalHonor}" />
                                <GridViewColumn Header="{loc:Loc Search_Col_Sets}" Width="190" DisplayMemberBinding="{Binding DisplaySets}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- Grilla de miniaturas (vista por defecto; filas virtualizadas) -->
                    <ListBox x:Name="CardGrid" Grid.Column="2" Focusable="True"
                             Background="#66140A05" BorderBrush="{StaticResource OutlineSoft}" BorderThickness="1"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SizeChanged="CardGrid_SizeChanged" PreviewKeyDown="CardGrid_PreviewKeyDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding}" ItemTemplate="{StaticResource GridCellTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Panel derecho: acciones sobre la carta seleccionada + su detalle -->
                    <Border x:Name="DetailPanelBorder" Grid.Column="4" Background="{StaticResource SurfaceGlass}" CornerRadius="9"
                            BorderBrush="{StaticResource OutlineSoft}" BorderThickness="1" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Sin pestañas: el contenido del mazo vive en la ventana de Mazos
                                 (ADR-042). Acá queda solo el detalle de la carta seleccionada. -->

                            <!-- Acciones sobre la carta seleccionada + feedback de AddCardResult -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,6">
                                <WrapPanel HorizontalAlignment="Center">
                                    <Button x:Name="AddToDeckBtn" Style="{StaticResource DetailActionBtn}"
                                            Content="{loc:Loc Search_AddToDeck}"
                                            ToolTip="{loc:Loc Search_AddToDeckTip}" Click="AddToDeckBtn_Click" />
                                    <Button x:Name="RemoveFromDeckBtn" Style="{StaticResource DetailActionBtn}"
                                            Content="{loc:Loc Search_RemoveFromDeck}" Click="RemoveFromDeckBtn_Click" />
                                    <Button x:Name="FavBtn" Style="{StaticResource DetailActionBtn}"
                                            Click="FavBtn_Click" />
                                    <Button x:Name="HideBtn" Style="{StaticResource DetailActionBtn}"
                                            Click="HideBtn_Click" />
                                    <!-- Faltaba: agregar/quitar de la lista activa, que en las celdas
                                         ya existía como ≡ pero en el detalle no estaba. -->
                                    <Button x:Name="ListBtn" Style="{StaticResource DetailActionBtn}"
                                            ToolTip="{loc:Loc Search_ListBtnTip}" Click="ListBtn_Click" />
                                </WrapPanel>
                                <TextBlock x:Name="DeckFeedback" Style="{StaticResource BodySmall}" FontSize="12"
                                           HorizontalAlignment="Center" Margin="0,5,0,0" Visibility="Collapsed"
                                           TextWrapping="Wrap" TextAlignment="Center" />
                            </StackPanel>

                            <!-- Contenido según el toggle -->
                            <v:CardDetailPanel x:Name="Detail" Grid.Row="1" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
