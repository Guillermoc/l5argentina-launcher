<Window
    x:Class="L5ArgentinaLauncher.Views.DeckWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:loc="clr-namespace:L5ArgentinaLauncher.Resources"
    xmlns:v="clr-namespace:L5ArgentinaLauncher.Views"
    Title="{loc:Loc Deck_WindowTitle}"
    Width="1323" Height="798" MinWidth="460" MinHeight="460"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    Background="{StaticResource ParchmentBackground}"
    Icon="pack://application:,,,/Assets/icon.png"
    StateChanged="Window_StateChanged"
    SizeChanged="Window_SizeChanged">

    <!-- Chrome custom (como SearchWindow): redimensionable y con maximizar -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="35" CornerRadius="0" GlassFrameThickness="0"
                            ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CardUiStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Botón de acción chico de la barra del editor -->
            <Style x:Key="DeckActionBtn" TargetType="Button" BasedOn="{StaticResource GhostButton}">
                <Setter Property="Height" Value="30" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="11,0" />
                <Setter Property="Margin" Value="6,0,0,0" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootLayout">
        <!-- Previsualización con Alt (ver ui.md): corrida del cursor para no taparse a sí misma -->
        <Popup x:Name="HoverPreview" Placement="Mouse" HorizontalOffset="26" VerticalOffset="26"
               AllowsTransparency="True" StaysOpen="True" IsHitTestVisible="False" Focusable="False">
            <Border Background="#F2140A05" BorderBrush="{StaticResource Gold}" BorderThickness="2"
                    CornerRadius="12" Padding="5">
                <Image x:Name="HoverPreviewImage" Stretch="Uniform" MaxWidth="430" MaxHeight="620" />
            </Border>
        </Popup>
        <!-- Fuera de la botonera: adentro de un StackPanel el Popup se mide como hijo y le come
             el ancho a los controles que siguen. Como HoverPreview, vive en la raíz. -->
        <Popup x:Name="ZoomPopup" PlacementTarget="{Binding ElementName=ZoomBtn}"
               Placement="Bottom" VerticalOffset="4" HorizontalOffset="-34"
               AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade"
               Closed="ZoomPopup_Closed">
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource GoldDim}"
                    BorderThickness="1" CornerRadius="8" Width="176" Padding="0,5">
                <StackPanel x:Name="ZoomOptions" />
            </Border>
        </Popup>

        <!-- Capas de fondo -->
        <Rectangle Fill="{StaticResource PaperOverlayBrush}" IsHitTestVisible="False" />
        <Rectangle Fill="{StaticResource BackgroundScrim}" IsHitTestVisible="False" />
        <Border BorderBrush="#552A1710" BorderThickness="1" IsHitTestVisible="False" />

        <DockPanel>
            <!-- ===== Title bar custom ===== -->
            <Grid DockPanel.Dock="Top" Height="36" Background="{StaticResource Surface}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="pack://application:,,,/Assets/icon.png" Width="20" Height="20" Margin="0,0,9,0" />
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontFamily="{StaticResource BrushFont}" FontSize="16"
                               Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Content="—"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MinButton_Click" />
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="□" FontSize="18"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MaxButton_Click" />
                    <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButton}" Content="✕"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <Grid Margin="16,12,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ===== Barra superior: mazo actual + acciones | conteos + orden ===== -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- El colapso de paneles vive ahora en los rieles laterales del cuerpo. -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="DeckTitle" Style="{StaticResource CardTitle}" FontSize="24"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <!-- Sin "Activar" ni badge "● Activo": el mazo seleccionado acá ES el
                                 activo del Buscador (ADR-042). -->
                        </StackPanel>

                        <!-- Seis botones permanentes para acciones que se usan una vez cada
                             tanto ocupaban toda la fila y competían con el nombre del mazo. Ahora
                             queda visible lo frecuente (abrir el Buscador para agregar cartas) y
                             el resto vive en el menú ⋯ (ADR-043). -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="OpenSearchBtn" Style="{StaticResource GhostButton}"
                                    Height="32" FontSize="14" Padding="14,0"
                                    Content="{loc:Loc Deck_OpenSearch}"
                                    ToolTip="{loc:Loc Deck_OpenSearchTip}" Click="OpenSearchBtn_Click" />
                            <Button x:Name="DeckMenuBtn" Style="{StaticResource IconButton}"
                                    Margin="8,0,0,0" Content="⋯" FontSize="17"
                                    ToolTip="{loc:Loc Deck_MenuTip}" Click="DeckMenuBtn_Click" />
                            <Button x:Name="HelpBtn" Style="{StaticResource IconButton}"
                                    Margin="8,0,0,0" Content="?" FontSize="14"
                                    ToolTip="{loc:Loc Help_Tip}" Click="Help_Click" />
                        </StackPanel>

                        <Popup x:Name="DeckMenuPopup" PlacementTarget="{Binding ElementName=DeckMenuBtn}"
                               Placement="Bottom" HorizontalOffset="-204" VerticalOffset="4"
                               AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource GoldDim}"
                                    BorderThickness="1" CornerRadius="8" Width="230" Padding="0,5">
                                <StackPanel>
                                    <Button x:Name="RenameBtn" Style="{StaticResource MenuRow}"
                                            Content="{loc:Loc Deck_RenameMenu}" Click="RenameBtn_Click" />
                                    <Button x:Name="DuplicateBtn" Style="{StaticResource MenuRow}"
                                            Content="{loc:Loc Deck_DuplicateMenu}" Click="DuplicateBtn_Click" />
                                    <Rectangle Height="1" Margin="10,5" Fill="{StaticResource OutlineSoft}" />
                                    <Button x:Name="ImportBtn" Style="{StaticResource MenuRow}"
                                            Content="{loc:Loc Deck_ImportMenu}" ToolTip="{loc:Loc Deck_ImportTip}"
                                            Click="ImportBtn_Click" />
                                    <Button x:Name="ExportBtn" Style="{StaticResource MenuRow}"
                                            Content="{loc:Loc Deck_ExportMenu}" ToolTip="{loc:Loc Deck_ExportTip}"
                                            Click="ExportBtn_Click" />
                                    <Button x:Name="PdfBtn" Style="{StaticResource MenuRow}"
                                            Content="{loc:Loc Deck_PdfMenu}" ToolTip="{loc:Loc Deck_PdfTip}"
                                            Click="PdfBtn_Click" />
                                    <Button x:Name="OpenFolderBtn" Style="{StaticResource MenuRow}"
                                            Content="{loc:Loc Deck_OpenFolderMenu}" ToolTip="{loc:Loc Deck_OpenFolderTip}"
                                            Click="OpenFolderBtn_Click" />
                                    <Rectangle Height="1" Margin="10,5" Fill="{StaticResource OutlineSoft}" />
                                    <!-- Acomodar las ventanas es una acción de VENTANA, no de mazo:
                                         no le corresponde un botón fijo en la barra del editor. -->
                                    <Button x:Name="SideBySideBtn" Style="{StaticResource MenuRow}"
                                            Content="{loc:Loc Deck_SideBySideMenu}"
                                            ToolTip="{loc:Loc Deck_SideBySideTip}" Click="SideBySide_Click" />
                                    <Rectangle Height="1" Margin="10,5" Fill="{StaticResource OutlineSoft}" />
                                    <Button x:Name="ClearTrimmedBtn" Style="{StaticResource MenuRow}"
                                            Content="{loc:Loc Deck_ClearTrimmedMenu}"
                                            ToolTip="{loc:Loc Deck_ClearTrimmedTip}"
                                            Click="ClearTrimmed_Click" />
                                    <Rectangle Height="1" Margin="10,5" Fill="{StaticResource OutlineSoft}" />
                                    <Button x:Name="DeleteBtn" Style="{StaticResource MenuRow}"
                                            Foreground="{StaticResource ErrorText}"
                                            Content="{loc:Loc Deck_DeleteMenu}" Click="DeleteBtn_Click" />
                                </StackPanel>
                            </Border>
                        </Popup>

                    </Grid>

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Conteos blandos (Dynasty/Fate en rojo si <40) + slots sin cubrir + status -->
                        <TextBlock x:Name="DeckCounts" Style="{StaticResource Body}" FontSize="14"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />

                        <TextBlock x:Name="StatusText" Grid.Column="1" Style="{StaticResource BodySmall}"
                                   Foreground="{StaticResource Gold}" VerticalAlignment="Center"
                                   Margin="0,0,14,0" Visibility="Collapsed" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Vista del mazo: filas o cartas en imagen (secciones en ambas;
                                 la app muestra imágenes, así que Grilla es el default) -->
                            <ToggleButton x:Name="ViewListBtn" Style="{StaticResource SegmentLeft}"
                                          Content="{loc:Loc Search_ViewList}" Click="ViewToggle_Click" />
                            <ToggleButton x:Name="ViewGridBtn" Style="{StaticResource SegmentMid}"
                                          IsChecked="True" Content="{loc:Loc Search_ViewGrid}"
                                          Click="ViewToggle_Click" />
                            <ToggleButton x:Name="ZoomBtn" Style="{StaticResource SegmentMenu}"
                                          ToolTip="{loc:Loc Search_ZoomTip}"
                                          Checked="ZoomBtn_Checked" Unchecked="ZoomBtn_Unchecked" />
                            <ComboBox x:Name="SortCombo" Style="{StaticResource ChipCombo}" Width="172"
                                      Margin="12,0,0,0" ToolTip="{loc:Loc Search_SortTip}"
                                      SelectionChanged="Sort_Changed" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ===== Cuerpo: mazos+filtros | cartas del mazo | detalle/stats ===== -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <!-- Anchos pensados para ~1200 DIP útiles (monitor 1080p a 125%).
                             Las columnas de 16 son los rieles de colapso y NO colapsan nunca:
                             son la única forma de reabrir el panel. -->
                        <ColumnDefinition x:Name="DecksCol" Width="260" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition x:Name="CenterCol" Width="*" MinWidth="300" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition x:Name="SideCol" Width="405" />
                    </Grid.ColumnDefinitions>

                    <!-- Divisorias arrastrables debajo, chevron de colapso encima (ver ui.md). -->
                    <GridSplitter x:Name="DecksSplitter" Grid.Column="1" Style="{StaticResource PaneSplitter}"
                                  DragDelta="DecksSplitter_DragDelta" DragCompleted="Splitter_DragCompleted" />
                    <GridSplitter x:Name="SideSplitter" Grid.Column="3" Style="{StaticResource PaneSplitter}"
                                  DragDelta="SideSplitter_DragDelta" DragCompleted="Splitter_DragCompleted" />

                    <!-- Rieles: el chevron apunta adónde se va el borde al hacer click. -->
                    <ToggleButton x:Name="DecksPaneBtn" Grid.Column="1" Style="{StaticResource PaneRail}"
                                  Content="❮" Tag="❯" ToolTip="{loc:Loc Deck_PaneDecksTip}"
                                  Click="PaneToggle_Click" />
                    <ToggleButton x:Name="SidePaneBtn" Grid.Column="3" Style="{StaticResource PaneRail}"
                                  Content="❯" Tag="❮" ToolTip="{loc:Loc Deck_PaneSideTip}"
                                  Click="PaneToggle_Click" />

                    <!-- Panel izquierdo: lista de mazos + filtros del contenido -->
                    <Border x:Name="DecksPanel" Grid.Column="0" Background="{StaticResource SurfaceGlassSoft}"
                            CornerRadius="9" BorderBrush="{StaticResource OutlineSoft}" BorderThickness="1"
                            Padding="12,8,12,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />  <!-- pestañas Abrir | Filtros -->
                                <RowDefinition Height="Auto" />  <!-- controles de "Abrir" -->
                                <RowDefinition Height="*" />     <!-- lista de mazos O filtros -->
                            </Grid.RowDefinitions>

                            <!-- Dos pestañas: elegir qué abrir vs. filtrar lo que ya está abierto.
                                 Son tareas distintas y competían por el mismo panel. -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Border Height="1" VerticalAlignment="Bottom"
                                        Background="{StaticResource OutlineSoft}" />
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="PaneOpenBtn" Style="{StaticResource PanelTab}"
                                                  IsChecked="True" Content="{loc:Loc Deck_PaneOpen}"
                                                  Click="PaneTab_Click" />
                                    <ToggleButton x:Name="PaneFiltersBtn" Style="{StaticResource PanelTab}"
                                                  Content="{loc:Loc Deck_PaneFilters}"
                                                  Click="PaneTab_Click" />
                                </StackPanel>
                            </Grid>

                            <StackPanel x:Name="OpenPane" Grid.Row="1" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DeckListHeader" Text="{loc:Loc Deck_ListHeader}"
                                               FontFamily="{StaticResource BrushFont}"
                                               FontSize="18" Foreground="{StaticResource GoldSoft}"
                                               VerticalAlignment="Center" />
                                    <Button x:Name="NewDeckBtn" Grid.Column="1" Content="＋"
                                            Style="{StaticResource GhostButton}"
                                            Height="28" FontSize="16" Padding="10,0"
                                            ToolTip="{loc:Loc Deck_NewTip}" Click="NewDeck_Click" />
                                </Grid>
                                <!-- Mazos y listas son lo mismo salvo dónde vive el .txt y el tope
                                     de copias: un solo editor, dos solapas (ADR-045) -->
                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                    <ToggleButton x:Name="TabDecksBtn" Style="{StaticResource SegmentLeft}"
                                                  IsChecked="True" Content="{loc:Loc Deck_TabDecks}"
                                                  ToolTip="{loc:Loc Deck_TabDecksTip}" Click="KindTab_Click" />
                                    <ToggleButton x:Name="TabListsBtn" Style="{StaticResource SegmentRight}"
                                                  Content="{loc:Loc Deck_TabLists}"
                                                  ToolTip="{loc:Loc Deck_TabListsTip}" Click="KindTab_Click" />
                                </StackPanel>

                                <!-- Buscar por nombre del mazo o por una carta que contenga -->
                                <Grid Margin="0,7,0,0">
                                    <TextBox x:Name="DeckSearchBox" Style="{StaticResource InvertedTextBox}"
                                             Height="28" FontSize="12" TextChanged="DeckSearch_Changed" />
                                    <TextBlock Text="{loc:Loc Deck_SearchHint}" Foreground="{StaticResource InputPlace}"
                                               Margin="12,0" VerticalAlignment="Center"
                                               IsHitTestVisible="False" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=DeckSearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <WrapPanel Margin="0,7,0,0">
                                    <ComboBox x:Name="DeckSortCombo" Style="{StaticResource ChipCombo}"
                                              Width="118" Margin="0,0,6,4"
                                              ToolTip="{loc:Loc Deck_SortTip}"
                                              SelectionChanged="DeckListFilter_Changed" />
                                    <ComboBox x:Name="DeckClanCombo" Style="{StaticResource ChipCombo}"
                                              Width="112" Margin="0,0,6,4"
                                              ToolTip="{loc:Loc Deck_ClanFilterTip}"
                                              SelectionChanged="DeckListFilter_Changed" />
                                    <ComboBox x:Name="DeckStateCombo" Style="{StaticResource ChipCombo}"
                                              Width="118" Margin="0,0,0,4"
                                              ToolTip="{loc:Loc Deck_StateFilterTip}"
                                              SelectionChanged="DeckListFilter_Changed" />
                                </WrapPanel>
                            </StackPanel>

                            <ListBox x:Name="DeckList" Grid.Row="2" Background="#40140A05"
                                     BorderBrush="{StaticResource OutlineSoft}" BorderThickness="1"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectionChanged="DeckList_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Foreground" Value="{StaticResource Text}" />
                                        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="bd" Background="Transparent" Padding="9,6">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#22C9A961" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#CC7D1F1C" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="14"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                       Foreground="{StaticResource TextDim}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Filtros sobre las cartas del mazo abierto -->
                            <StackPanel x:Name="FiltersPane" Grid.Row="2" VerticalAlignment="Top"
                                        Visibility="Collapsed">
                                <TextBlock Text="{loc:Loc Deck_FiltersHeader}" FontFamily="{StaticResource BrushFont}"
                                           FontSize="16" Foreground="{StaticResource GoldSoft}" Margin="0,0,0,6" />
                                <Grid>
                                    <TextBox x:Name="FilterBox" Style="{StaticResource InvertedTextBox}" Height="30"
                                             FontSize="13" TextChanged="Filter_Changed" />
                                    <TextBlock Text="{loc:Loc Deck_FilterHint}" Foreground="{StaticResource InputPlace}"
                                               Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <WrapPanel Margin="0,8,0,0">
                                    <ToggleButton x:Name="GroupStarterBtn" Style="{StaticResource FilterChip}"
                                                  IsChecked="True" Content="Starter"
                                                  Checked="Filter_Changed" Unchecked="Filter_Changed" />
                                    <ToggleButton x:Name="GroupDynastyBtn" Style="{StaticResource FilterChip}"
                                                  IsChecked="True" Content="Dynasty"
                                                  Checked="Filter_Changed" Unchecked="Filter_Changed" />
                                    <ToggleButton x:Name="GroupFateBtn" Style="{StaticResource FilterChip}"
                                                  IsChecked="True" Content="Fate"
                                                  Checked="Filter_Changed" Unchecked="Filter_Changed" />
                                </WrapPanel>
                                <!-- Recortadas: prendido por defecto, al revés que la app. Sin el
                                     período de gracia táctil de 2,5 s, esconderlas al recortar deja
                                     al usuario sin ver lo que acaba de hacer. Apagarlo muestra el
                                     mazo tal como se juega. -->
                                <ToggleButton x:Name="ShowTrimmedBtn" Style="{StaticResource FilterChip}"
                                              Margin="0,8,0,0" IsChecked="True"
                                              Content="{loc:Loc Deck_ShowTrimmed}"
                                              ToolTip="{loc:Loc Deck_ShowTrimmedTip}"
                                              Checked="ShowTrimmed_Click" Unchecked="ShowTrimmed_Click" />
                                <TextBlock Text="{loc:Loc Deck_AddFromSearchHint}" Style="{StaticResource BodySmall}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Centro: cartas del mazo agrupadas Starter/Dynasty/Fate → tipo -->
                    <Border Grid.Column="2" Background="#66140A05" BorderBrush="{StaticResource OutlineSoft}"
                            BorderThickness="1" CornerRadius="9">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="14,8,14,8"
                                          PreviewMouseWheel="DeckBody_PreviewMouseWheel">
                                <StackPanel x:Name="DeckBody" />
                            </ScrollViewer>

                            <!-- Notas del mazo (auto-guardado con debounce 1s, como la app) -->
                            <Expander x:Name="NotesExpander" Grid.Row="1" Header="{loc:Loc Deck_NotesHeader}"
                                      Style="{StaticResource SubExpander}" Margin="14,0,14,8">
                                <TextBox x:Name="NotesBox" Style="{StaticResource InvertedTextBox}"
                                         MinHeight="64" MaxHeight="140" FontSize="13" AcceptsReturn="True"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         TextChanged="NotesBox_TextChanged" />
                            </Expander>
                        </Grid>
                    </Border>

                    <!-- Panel derecho: detalle de carta / stats del mazo -->
                    <Border x:Name="SidePanel" Grid.Column="4" Background="{StaticResource SurfaceGlass}"
                            CornerRadius="9" BorderBrush="{StaticResource OutlineSoft}" BorderThickness="1"
                            Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Pestañas Carta / Stats: la activa tapa la línea base y no dibuja
                                 borde inferior, así se funde con el contenido. -->
                            <Grid Margin="0,0,0,8">
                                <Border Height="1" VerticalAlignment="Bottom"
                                        Background="{StaticResource OutlineSoft}" />
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="TabCardBtn" Style="{StaticResource PanelTab}"
                                                  Content="{loc:Loc Deck_TabCard}" Click="Tab_Click" />
                                    <ToggleButton x:Name="TabStatsBtn" Style="{StaticResource PanelTab}"
                                                  IsChecked="True" Content="{loc:Loc Deck_TabStats}"
                                                  Click="Tab_Click" />
                                </StackPanel>
                            </Grid>

                            <v:CardDetailPanel x:Name="Detail" Grid.Row="1" Visibility="Collapsed" />
                            <ScrollViewer x:Name="StatsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="StatsBody" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
