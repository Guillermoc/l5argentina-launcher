<Window
    x:Class="L5ArgentinaLauncher.Views.PdfExportWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:loc="clr-namespace:L5ArgentinaLauncher.Resources"
    Title="{loc:Loc Pdf_WindowTitle}"
    Width="620" Height="720" MinWidth="480" MinHeight="420"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    ShowInTaskbar="False"
    Background="{StaticResource ParchmentBackground}"
    Icon="pack://application:,,,/Assets/icon.png">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="35" CornerRadius="0" GlassFrameThickness="0"
                            ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CardUiStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Botón redondo del stepper de copias -->
            <Style x:Key="StepBtn" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="FontSize" Value="15" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Rectangle Fill="{StaticResource PaperOverlayBrush}" IsHitTestVisible="False" />
        <Rectangle Fill="{StaticResource BackgroundScrim}" IsHitTestVisible="False" />
        <Border BorderBrush="#552A1710" BorderThickness="1" IsHitTestVisible="False" />

        <DockPanel>
            <!-- ===== Title bar ===== -->
            <Grid DockPanel.Dock="Top" Height="36" Background="{StaticResource Surface}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="pack://application:,,,/Assets/icon.png" Width="20" Height="20" Margin="0,0,9,0" />
                    <TextBlock x:Name="TitleText" FontFamily="{StaticResource BrushFont}" FontSize="16"
                               Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButton}" Content="✕"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <!-- ===== Pie: opciones + generar ===== -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource OutlineSoft}" BorderThickness="0,1,0,0" Padding="16,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Pdf_PageSize}" VerticalAlignment="Center"
                                       FontFamily="{StaticResource BodyFont}" FontSize="13"
                                       Foreground="{StaticResource TextDim}" Margin="0,0,8,0" />
                            <ToggleButton x:Name="A4Btn" Style="{StaticResource SegmentLeft}"
                                          Content="{loc:Loc Pdf_PageA4}" Click="PageSize_Click" />
                            <ToggleButton x:Name="LetterBtn" Style="{StaticResource SegmentRight}"
                                          Content="{loc:Loc Pdf_PageLetter}" Click="PageSize_Click" />
                        </StackPanel>

                        <CheckBox x:Name="MarginCheck" Grid.Column="1" VerticalAlignment="Center"
                                  Style="{StaticResource FilterCheck}"
                                  Content="{loc:Loc Pdf_Margin1mm}" ToolTip="{loc:Loc Pdf_Margin1mmTip}"
                                  Click="Margin_Click" />
                    </Grid>

                    <TextBlock x:Name="SummaryText" Margin="0,10,0,0"
                               FontFamily="{StaticResource BodyFont}" FontSize="12"
                               Foreground="{StaticResource TextDim}" TextWrapping="Wrap" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ResetBtn" Style="{StaticResource GhostButton}" Height="30"
                                Padding="12,0" Content="{loc:Loc Pdf_Reset}"
                                ToolTip="{loc:Loc Pdf_ResetTip}" Click="Reset_Click" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="CancelBtn" Style="{StaticResource GhostButton}"
                                    Height="30" Padding="14,0" Margin="0,0,8,0" IsCancel="True"
                                    Content="{loc:Loc Deck_PromptCancel}" Click="CloseButton_Click" />
                            <Button x:Name="GenerateBtn" Style="{StaticResource GhostButton}"
                                    Height="30" Padding="16,0" IsDefault="True"
                                    Content="{loc:Loc Pdf_Generate}" Click="Generate_Click" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== Lista de cartas ===== -->
            <Grid Margin="16,12,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{loc:Loc Pdf_Intro}" TextWrapping="Wrap" Margin="0,0,0,10"
                           FontFamily="{StaticResource BodyFont}" FontSize="12.5"
                           Foreground="{StaticResource TextDim}" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="CardList" />
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
