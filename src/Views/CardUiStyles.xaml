<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:L5ArgentinaLauncher.Resources">

    <!-- Estilos compartidos por el Buscador y el editor de Mazos (extraídos de SearchWindow).
         Los implícitos (CheckBox/ComboBox/Expander/GridViewColumnHeader) aplican solo dentro
         de las ventanas que mergean este diccionario — no son app-wide a propósito, para no
         tocar MainWindow. -->

    <!-- ══ CheckBox oscuro con tilde oro (implícito) ══ -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="box" Width="16" Height="16" CornerRadius="3" BorderThickness="1"
                                BorderBrush="{StaticResource GoldDim}" Background="#40140A05"
                                VerticalAlignment="Center">
                            <Path x:Name="mark" Data="M 3,8 L 6.5,11.5 L 13,4" Stroke="{StaticResource Gold}"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Gold}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="mark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Gold}" />
                            <Setter TargetName="box" Property="Background" Value="#597D1F1C" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FilterCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Margin" Value="0,3,0,3" />
    </Style>

    <!-- ══ ComboBox pergamino (implícito; soporta editable) ══ -->
    <LinearGradientBrush x:Key="InputFieldBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF0E2BF" Offset="0" />
        <GradientStop Color="#FFE8D6AD" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="ComboEditBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource InputText}" />
        <Setter Property="CaretBrush" Value="{StaticResource InputText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Background="Transparent" Padding="11,6">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#33C9A961" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Red}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Fondo, borde, texto y CornerRadius (en Tag) salen de propiedades, no de recursos fijos:
         así ChipCombo puede reusar este mismo template con la paleta oscura. -->
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource InputText}" />
        <Setter Property="Background" Value="{StaticResource InputFieldBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource InputBorder}" />
        <Setter Property="Tag" Value="6" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MaxDropDownHeight" Value="320" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bd" BorderThickness="1"
                                            CornerRadius="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                        <Path Data="M 0 0 L 4.5 4.5 L 9 0"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                              StrokeThickness="1.6" HorizontalAlignment="Right"
                                              VerticalAlignment="Center" Margin="0,1,10,0" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Gold}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Gold}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="selectedContent" Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="11,0,26,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                        <TextBox x:Name="PART_EditableTextBox" Style="{StaticResource ComboEditBox}"
                                 Margin="11,0,26,0" VerticalAlignment="Center" Visibility="Hidden"
                                 FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource GoldDim}"
                                    BorderThickness="1" CornerRadius="6" Margin="0,3,0,0"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="selectedContent" Property="Visibility" Value="Hidden" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Combo "de barra": mismo template, paleta de los toggles. Para selectores que conviven con
         chips y botones (orden, lista activa, mazo activo) y no son campos de entrada: el pergamino
         claro los hacía leer como cajas de búsqueda y pesaban más que los controles de al lado
         ([ADR-035](../DECISIONS.md#adr-035)). -->
    <Style x:Key="ChipCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="#452A1710" />
        <Setter Property="BorderBrush" Value="{StaticResource OutlineSoft}" />
        <Setter Property="Tag" Value="12" />
        <Setter Property="Height" Value="26" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- ══ Expander con flecha oro (implícito; tipografía por instancia) ══ -->
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource GoldSoft}" />
        <Setter Property="FontFamily" Value="{StaticResource BrushFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton x:Name="hdr" Focusable="False" Cursor="Hand"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" Padding="0,6">
                                        <StackPanel Orientation="Horizontal">
                                            <Path x:Name="arrow" Data="M 0 0 L 5 5 L 0 10"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                  StrokeThickness="1.8" VerticalAlignment="Center"
                                                  Margin="2,1,9,0" RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <RotateTransform Angle="0" />
                                                </Path.RenderTransform>
                                            </Path>
                                            <ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                              TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                              VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="arrow" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="90" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="body" Visibility="Collapsed" Margin="16,2,0,4" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="body" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sección de filtros (Expander de primer nivel) -->
    <Style x:Key="FilterExpander" TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <!-- Sub-sección (Opciones avanzadas) -->
    <Style x:Key="SubExpander" TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <!-- Chip de filtro (estilo Style_guide: seleccionado = rojo acento, borde oro) -->
    <Style x:Key="FilterChip" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" CornerRadius="12" Background="#452A1710"
                            BorderThickness="1" BorderBrush="{StaticResource OutlineSoft}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource GoldDim}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Red}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Gold}" />
                        </Trigger>
                        <!-- Sin esto, un chip deshabilitado (p.ej. Impresiones en vista Lista)
                             se veía idéntico a uno activo y aceptaba el click sin efecto. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Variante chica del chip: etiquetas largas que deben leerse como sub-opción y no
         competir con los controles principales de la barra (ej. "Ver todas las impresiones"). -->
    <Style x:Key="FilterChipSmall" TargetType="ToggleButton" BasedOn="{StaticResource FilterChip}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="8,3" />
    </Style>

    <!-- ══ Segmentado (selección exclusiva: Lista | Grilla) ══
         Un solo bloque con divisoria interna, en vez de dos chips sueltos que se leen
         como filtros independientes. Se usan de a pares y sin margen entre sí. -->
    <ControlTemplate x:Key="SegmentTemplate" TargetType="ToggleButton">
        <Border x:Name="bd" CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                Background="#452A1710" BorderThickness="{TemplateBinding BorderThickness}"
                BorderBrush="{StaticResource OutlineSoft}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource GoldDim}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource Red}" />
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Gold}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="SegmentLeft" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Tag" Value="12,0,0,12" />
        <Setter Property="Template" Value="{StaticResource SegmentTemplate}" />
    </Style>

    <!-- Sin borde izquierdo: comparte la divisoria con el segmento anterior. -->
    <Style x:Key="SegmentRight" TargetType="ToggleButton" BasedOn="{StaticResource SegmentLeft}">
        <Setter Property="BorderThickness" Value="0,1,1,1" />
        <Setter Property="Tag" Value="0,12,12,0" />
    </Style>

    <!-- Segmento del medio: sin borde izquierdo y sin redondear ninguna punta. -->
    <Style x:Key="SegmentMid" TargetType="ToggleButton" BasedOn="{StaticResource SegmentLeft}">
        <Setter Property="BorderThickness" Value="0,1,1,1" />
        <Setter Property="Tag" Value="0,0,0,0" />
    </Style>

    <!-- ══ Último segmento, pero desplegable en vez de opción ══
         El zoom se agrupó con Lista|Grilla porque es lo que es —una propiedad de la vista, no una
         acción— pero no es una tercera opción del grupo: abre un popup. Por eso NO se pinta de rojo
         al estar "checked" (checked acá solo significa "el popup está abierto"); solo marca el
         borde, como cualquier menú abierto. -->
    <Style x:Key="SegmentMenu" TargetType="ToggleButton" BasedOn="{StaticResource SegmentRight}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" CornerRadius="0,12,12,0" Background="#452A1710"
                            BorderThickness="0,1,1,1" BorderBrush="{StaticResource OutlineSoft}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource GoldDim}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Gold}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Botón de ícono con estado en el glifo, no en el fondo ══
         Para ↑/↓ de orden: "descendente" no es "filtro activo", así que no se pinta de rojo. -->
    <Style x:Key="IconToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource Gold}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" CornerRadius="6" Background="#452A1710"
                            BorderThickness="1" BorderBrush="{StaticResource OutlineSoft}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource GoldDim}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Versión Button del anterior: acciones puntuales de la barra (nueva lista, borrar lista). -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Gold}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="13" Background="#452A1710"
                            BorderThickness="1" BorderBrush="{StaticResource OutlineSoft}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource GoldDim}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Acción del detalle de carta ══
         Glifo + etiqueta en una píldora chata: la fila de acciones del panel derecho tenía cuatro
         GhostButton iguales y no se distinguía "+ Mazo" de "Ocultar". El glifo hace el trabajo. -->
    <Style x:Key="DetailActionBtn" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="2,2" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="13" Background="#452A1710"
                            BorderThickness="1" BorderBrush="{StaticResource OutlineSoft}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Estado "puesto" (favorita, oculta, en la lista): el texto solo no
                             alcanzaba — la píldora se veía igual en los dos estados, mientras que
                             el ★ de la celda sí se pone dorado. Va antes del hover para que el
                             mouse encima siga ganando. Lo prende el code-behind con Tag="on". -->
                        <Trigger Property="Tag" Value="on">
                            <Setter TargetName="bd" Property="Background" Value="#3AC9A961" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Gold}" />
                            <Setter Property="Foreground" Value="{StaticResource Gold}" />
                        </Trigger>
                        <!-- Ocultar es la única acción "negativa": prendida va en rojo, igual que
                             el ⊘ de la celda. -->
                        <Trigger Property="Tag" Value="off-warn">
                            <Setter TargetName="bd" Property="Background" Value="#3AC1443A" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource ErrorText}" />
                            <Setter Property="Foreground" Value="{StaticResource ErrorText}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Red}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Gold}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Fila de menú desplegable ══
         Acción de un popup: ancho completo, texto a la izquierda, hover rojo. Mismo lenguaje que
         los ítems del ComboBox, que son el otro popup de la app. -->
    <Style x:Key="MenuRow" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="Transparent" Padding="14,7">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Red}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Título que además es selector ══
         El nombre del mazo abierto es el disparador del picker: se lee como título (misma tipografía
         y tamaño que antes) y solo al pasar el mouse aparece el fondo que delata que es clickeable.
         Un botón con aspecto de botón al lado del título habría sumado un control más a la barra,
         que es justo lo que ADR-050 saca. -->
    <Style x:Key="TitlePicker" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" CornerRadius="8" Background="Transparent"
                            BorderThickness="1" BorderBrush="Transparent" Padding="8,2">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#33C9A961" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource GoldDim}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#33C9A961" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Gold}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Divisoria arrastrable del panel lateral ══
         La columna del riel hace DOS cosas: arrastrarla mueve el borde del panel (GridSplitter,
         estilo PaneSplitter) y el nudo del centro lo colapsa de un click. Por eso el chevron dejó
         de ocupar toda la altura: si la píldora tapaba la columna entera, no quedaba dónde
         agarrar para arrastrar. Su columna NUNCA colapsa: es la única forma de reabrir el panel. -->
    <Style x:Key="PaneSplitter" TargetType="GridSplitter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="ResizeDirection" Value="Columns" />
        <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="Transparent">
                        <!-- Línea fina de 1px: dice "acá hay un borde" sin pesar visualmente. -->
                        <Rectangle x:Name="line" Width="1" HorizontalAlignment="Center"
                                   Fill="{StaticResource Outline}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="line" Property="Fill" Value="{StaticResource GoldDim}" />
                            <Setter TargetName="line" Property="Width" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nudo de colapso, centrado sobre la divisoria.
         Content = glifo con el panel abierto; Tag = glifo con el panel colapsado.
         El chevron apunta adónde se va el borde al hacer click. -->
    <Style x:Key="PaneRail" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource GoldDim}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="IsChecked" Value="True" />
        <Setter Property="Height" Value="62" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <!-- Fondo opaco: con SurfaceGlassSoft solo se veían los bordes de 1px y
                             el riel se leía como línea decorativa, no como control. -->
                        <Border x:Name="bd" Width="14" HorizontalAlignment="Center" CornerRadius="7"
                                Background="#99140A05" BorderThickness="1"
                                BorderBrush="{StaticResource Outline}">
                            <TextBlock x:Name="gl" Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource GoldDim}" />
                            <Setter TargetName="gl" Property="Foreground" Value="{StaticResource Gold}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="gl" Property="Text"
                                    Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Pestaña del panel derecho (Carta | Mazo, Carta | Stats) ══
         Se usa sobre una línea base de ancho completo: la pestaña activa la tapa con su
         fondo opaco y no dibuja borde inferior, así se funde con el contenido de abajo. -->
    <Style x:Key="PanelTab" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,3,0" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" CornerRadius="7,7,0,0" Background="Transparent"
                            BorderThickness="1,1,1,0" BorderBrush="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource OutlineSoft}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Red}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Gold}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Input numérico chico para rangos de stats -->
    <Style x:Key="SmallNumBox" TargetType="TextBox" BasedOn="{StaticResource InvertedTextBox}">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <!-- Chip removible (keyword agregada): click = quitar -->
    <Style x:Key="RemovableChip" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="ToolTip" Value="{loc:Loc Search_ChipRemoveTip}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="11" Background="{StaticResource Red}"
                            BorderThickness="1" BorderBrush="{StaticResource GoldDim}" Padding="9,3">
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter VerticalAlignment="Center" />
                            <TextBlock Text=" ✕" FontSize="11" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Gold}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Encabezado de columna de la grilla -->
    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="Foreground" Value="{StaticResource GoldSoft}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTip" Value="{loc:Loc Search_HeaderSortTip}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource OutlineSoft}"
                                BorderThickness="0,0,1,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="8"
                               Margin="0,0,-4,0" Cursor="SizeWE">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#7D2A1710" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
