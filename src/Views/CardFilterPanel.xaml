<UserControl
    x:Class="L5ArgentinaLauncher.Views.CardFilterPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:L5ArgentinaLauncher.Resources">

    <!-- Panel de filtros sobre cartas, compartido por el Buscador y el editor de Mazos
         (ADR-058). En el Buscador filtra el catálogo; en Mazos, las cartas del mazo abierto.
         Los presets NO viven acá: guardan cosas que solo existen en el Buscador (conjunto
         activo, favoritas, orden), así que quedan en su panel. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CardUiStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <!-- 1. Keywords -->
        <Expander x:Name="SectionKeywords" Header="{loc:Loc Search_Section_Keywords}"
                  Style="{StaticResource FilterExpander}" IsExpanded="True">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="KwCombo" IsEditable="True" Height="28"
                              IsTextSearchEnabled="False" KeyDown="KwCombo_KeyDown" />
                    <Button Grid.Column="1" Content="+" Style="{StaticResource GhostButton}"
                            Height="28" Padding="10,0" FontSize="16" Margin="6,0,0,0"
                            Click="KwAdd_Click" ToolTip="{loc:Loc Search_KwAddTip}" />
                </Grid>
                <WrapPanel x:Name="KwChips" Margin="0,8,0,0" />

                <Expander Header="{loc:Loc Search_KwAdvanced}" Style="{StaticResource SubExpander}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Search_KwExclude}" Style="{StaticResource BodySmall}"
                                   FontSize="12" Margin="0,2,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="NegKwCombo" IsEditable="True" Height="28"
                                      IsTextSearchEnabled="False" KeyDown="NegKwCombo_KeyDown" />
                            <Button Grid.Column="1" Content="−" Style="{StaticResource GhostButton}"
                                    Height="28" Padding="10,0" FontSize="16" Margin="6,0,0,0"
                                    Click="NegKwAdd_Click" ToolTip="{loc:Loc Search_KwExcludeTip}" />
                        </Grid>
                        <WrapPanel x:Name="NegKwChips" Margin="0,8,0,0" />

                        <CheckBox x:Name="KwMatchAllBox" Content="{loc:Loc Search_KwMatchAll}"
                                  Style="{StaticResource FilterCheck}" IsChecked="True"
                                  Checked="Toggle_Changed" Unchecked="Toggle_Changed" />
                        <CheckBox x:Name="KwActionBox" Content="{loc:Loc Search_KwAction}"
                                  Style="{StaticResource FilterCheck}" IsChecked="True"
                                  Checked="Toggle_Changed" Unchecked="Toggle_Changed" />
                        <CheckBox x:Name="KwSubtitleBox" Content="{loc:Loc Search_KwSubtitle}"
                                  Style="{StaticResource FilterCheck}" IsChecked="True"
                                  Checked="Toggle_Changed" Unchecked="Toggle_Changed" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Expander>

        <!-- 2. Texto de la carta -->
        <Expander x:Name="SectionText" Header="{loc:Loc Search_Section_CardText}"
                  Style="{StaticResource FilterExpander}" IsExpanded="True">
            <StackPanel>
                <TextBox x:Name="TextSearchBox" Style="{StaticResource InvertedTextBox}" Height="32"
                         FontSize="13" TextChanged="Text_Changed"
                         ToolTip="{loc:Loc Search_CardTextTip}" />
                <TextBlock Text="{loc:Loc Search_CardTextHint}" Style="{StaticResource BodySmall}"
                           FontSize="11" Margin="2,4,0,0" />
            </StackPanel>
        </Expander>

        <!-- 3. Tipo -->
        <Expander x:Name="SectionType" Header="{loc:Loc Search_Section_Type}"
                  Style="{StaticResource FilterExpander}" IsExpanded="True">
            <WrapPanel x:Name="TypeChips" />
        </Expander>

        <!-- 4. Clan -->
        <Expander x:Name="SectionClan" Header="{loc:Loc Search_Section_Clan}"
                  Style="{StaticResource FilterExpander}" IsExpanded="True">
            <WrapPanel x:Name="ClanChips" />
        </Expander>

        <!-- 5. Designador -->
        <Expander x:Name="SectionDesignators" Header="{loc:Loc Search_Section_Designators}"
                  Style="{StaticResource FilterExpander}">
            <WrapPanel x:Name="DesignatorChips" />
        </Expander>

        <!-- 6. Stats -->
        <Expander x:Name="SectionStats" Header="{loc:Loc Search_Section_Stats}"
                  Style="{StaticResource FilterExpander}">
            <StackPanel x:Name="StatsPanel" Margin="0,4,0,0" />
        </Expander>

        <!-- 7. Edición -->
        <Expander x:Name="SectionSets" Header="{loc:Loc Search_Section_Sets}"
                  Style="{StaticResource FilterExpander}">
            <StackPanel x:Name="SetChecks" Margin="0,4,0,0" />
        </Expander>

        <!-- 8. Rareza -->
        <Expander x:Name="SectionRarity" Header="{loc:Loc Search_Section_Rarity}"
                  Style="{StaticResource FilterExpander}">
            <WrapPanel x:Name="RarityChips" />
        </Expander>

        <!-- 9. Otros (los toggles frecuentes viven en la barra superior del Buscador) -->
        <Expander x:Name="SectionOther" Header="{loc:Loc Search_Section_Other}"
                  Style="{StaticResource FilterExpander}">
            <StackPanel>
                <CheckBox x:Name="IncludeBannedBox" Content="{loc:Loc Search_IncludeBanned}"
                          Style="{StaticResource FilterCheck}"
                          Checked="Toggle_Changed" Unchecked="Toggle_Changed" />
                <CheckBox x:Name="OnlyHiddenBox" Content="{loc:Loc Search_OnlyHidden}"
                          Style="{StaticResource FilterCheck}"
                          Checked="Toggle_Changed" Unchecked="Toggle_Changed" />
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
